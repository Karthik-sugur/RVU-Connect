rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRvuEmail() {
      return signedIn()
        && request.auth.token.email is string;
    }

    function isSuperAdmin() {
      return isRvuEmail()
        && (
          exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid))
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin'
          )
        );
    }

    function authEmailKey() {
      // Document ids for coreMembers are stored lowercased by the client.
      return request.auth.token.email.lower();
    }

    function isApprovedClubCore(clubId) {
      return isRvuEmail()
        && (
          (
            exists(/databases/$(database)/documents/clubs/$(clubId)/coreMembers/$(authEmailKey()))
            && get(/databases/$(database)/documents/clubs/$(clubId)/coreMembers/$(authEmailKey())).data.status == 'approved'
          )
          || (
            exists(/databases/$(database)/documents/clubs/$(clubId)/coreMembers/$(request.auth.token.email))
            && get(/databases/$(database)/documents/clubs/$(clubId)/coreMembers/$(request.auth.token.email)).data.status == 'approved'
          )
        );
    }

    function isClubFounder(clubId) {
      return isRvuEmail()
        && exists(/databases/$(database)/documents/clubs/$(clubId))
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.founderEmail is string
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.founderEmail.lower() == authEmailKey();
    }

    function isApprovedSchoolRep() {
      return isRvuEmail()
        && (
          (
            exists(/databases/$(database)/documents/hostRequests/$('schoolRepresentative_' + request.auth.uid))
            && get(/databases/$(database)/documents/hostRequests/$('schoolRepresentative_' + request.auth.uid)).data.status == 'approved'
          )
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolRepApproved == true
          )
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['schoolRepresentative', 'schoolRep']
          )
        );
    }

    // Deterministic application id: {clubId}_{uid}
    function hasApprovedClubApplication(clubId) {
      return exists(/databases/$(database)/documents/clubApplications/$(clubId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/clubApplications/$(clubId + '_' + request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/clubApplications/$(clubId + '_' + request.auth.uid)).data.uid == request.auth.uid;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function createsOwnDoc(uid) {
      return request.auth.uid == uid;
    }

    function unchanged(field) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }

    match /users/{uid} {
      allow create: if isRvuEmail()
        && createsOwnDoc(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.email is string
        && request.resource.data.email.lower() == authEmailKey();

      allow read: if isSuperAdmin() || (isRvuEmail() && createsOwnDoc(uid));

      allow update: if isSuperAdmin()
        || (
          isRvuEmail()
          && createsOwnDoc(uid)
          && unchanged('role')
          && unchanged('email')
          && unchanged('schoolRepApproved')
          && unchanged('clubCoreApproved')
        )
        // Self-heal sticky school-rep flag when the canonical approved host request already exists.
        // Lets dual-role users recover without running Repair every time.
        || (
          isRvuEmail()
          && createsOwnDoc(uid)
          && unchanged('role')
          && unchanged('email')
          && unchanged('clubCoreApproved')
          && request.resource.data.schoolRepApproved == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['schoolRepApproved', 'schoolScope', 'updatedAt'])
          && exists(/databases/$(database)/documents/hostRequests/$('schoolRepresentative_' + request.auth.uid))
          && get(/databases/$(database)/documents/hostRequests/$('schoolRepresentative_' + request.auth.uid)).data.status == 'approved'
        );

      allow delete: if isSuperAdmin();

      match /savedItems/{savedId} {
        allow read, create, update, delete: if isRvuEmail() && createsOwnDoc(uid);
      }

      match /followedClubs/{clubId} {
        allow read, create, update, delete: if isRvuEmail() && createsOwnDoc(uid);
      }

      match /rsvps/{eventId} {
        allow read, create, update, delete: if isRvuEmail() && createsOwnDoc(uid);
      }


    }

    match /superAdmins/{adminId} {
      allow read: if isRvuEmail() && adminId == request.auth.uid;
      allow create, update, delete: if isSuperAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if isRvuEmail();
      allow create, update, delete: if isSuperAdmin();
    }

    match /contentReviews/{reviewId} {
      allow create: if isRvuEmail();
      allow read, update, delete: if isSuperAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isRvuEmail();
      allow create, update, delete: if isSuperAdmin();
    }

    match /clubs/{clubId} {
      allow read: if isRvuEmail() && (resource.data.status == 'approved' || isSuperAdmin() || isApprovedClubCore(clubId));
      allow create, delete: if isSuperAdmin();

      allow update: if isSuperAdmin() || (isApprovedClubCore(clubId) && unchanged('createdAt') && unchanged('createdBy'));

      match /coreMembers/{memberEmail} {
        // Own membership by doc id, or by uid/email fields (collectionGroup-safe), or fellow cores.
        allow read: if isSuperAdmin()
          || (isRvuEmail() && (
            memberEmail == request.auth.token.email
            || memberEmail == authEmailKey()
            || resource.data.uid == request.auth.uid
            || (resource.data.email is string && resource.data.email.lower() == authEmailKey())
          ))
          || isApprovedClubCore(clubId);

        // Super admin / approved core / founder can manage the roster.
        // Applicant can self-heal their own approved membership when the deterministic application exists.
        allow create, update: if isSuperAdmin()
          || isApprovedClubCore(clubId)
          || isClubFounder(clubId)
          || (
            isRvuEmail()
            && memberEmail == authEmailKey()
            && hasApprovedClubApplication(clubId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.email == authEmailKey()
            && request.resource.data.status == 'approved'
          );

        allow delete: if isSuperAdmin()
          || isApprovedClubCore(clubId)
          || (isRvuEmail() && (memberEmail == request.auth.token.email || memberEmail == authEmailKey()));
      }
    }

    match /clubApplications/{applicationId} {
      // Students create their own pending app; cores/founders may create an approved mirror while approving.
      allow create: if isRvuEmail()
        && (
          (
            request.resource.data.uid == request.auth.uid
            && request.resource.data.email is string
            && request.resource.data.email.lower() == authEmailKey()
            && request.resource.data.status == 'pending'
          )
          || (
            request.resource.data.status == 'approved'
            && request.resource.data.clubId is string
            && (isSuperAdmin() || isApprovedClubCore(request.resource.data.clubId) || isClubFounder(request.resource.data.clubId))
          )
        );

      allow read: if isSuperAdmin()
        || (isRvuEmail() && resource.data.uid == request.auth.uid)
        || isApprovedClubCore(resource.data.clubId)
        || isClubFounder(resource.data.clubId);

      allow update: if isSuperAdmin()
        || (isRvuEmail()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && (
              (request.resource.data.status == 'withdrawn' && resource.data.status == 'pending')
              || (request.resource.data.status == 'pending' && resource.data.status in ['rejected', 'withdrawn'])
            )
            && request.resource.data.email is string
            && request.resource.data.email.lower() == authEmailKey()
            && request.resource.data.clubId == resource.data.clubId)
        || isApprovedClubCore(resource.data.clubId)
        || isClubFounder(resource.data.clubId);

      allow delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if isRvuEmail() && (isPublished() || isSuperAdmin());

      allow create: if isRvuEmail()
        && (
          (request.resource.data.hostType == 'club' && isApprovedClubCore(request.resource.data.clubId))
          || (request.resource.data.hostType == 'school' && isApprovedSchoolRep())
          || isSuperAdmin()
        );

      allow update: if isSuperAdmin()
        || (resource.data.hostType == 'club' && isApprovedClubCore(resource.data.clubId) && unchanged('createdAt'))
        || (resource.data.hostType == 'school' && isApprovedSchoolRep() && unchanged('createdAt'));
        
      allow delete: if isSuperAdmin()
        || (resource.data.hostType == 'club' && isApprovedClubCore(resource.data.clubId))
        || (resource.data.hostType == 'school' && isApprovedSchoolRep());

      match /rsvps/{uid} {
        allow read: if isSuperAdmin() || createsOwnDoc(uid);
        allow create, update, delete: if isRvuEmail() && createsOwnDoc(uid);
      }
    }

    match /announcements/{announcementId} {
      allow read: if isRvuEmail() && (isPublished() || isSuperAdmin());

      allow create: if isRvuEmail()
        && (
          (request.resource.data.sourceType == 'club' && isApprovedClubCore(request.resource.data.clubId))
          || (request.resource.data.sourceType == 'school' && isApprovedSchoolRep())
          || isSuperAdmin()
        );

      allow update: if isSuperAdmin()
        || (resource.data.sourceType == 'club' && isApprovedClubCore(resource.data.clubId) && unchanged('createdAt'))
        || (resource.data.sourceType == 'school' && isApprovedSchoolRep() && unchanged('createdAt'));
        
      allow delete: if isSuperAdmin()
        || (resource.data.sourceType == 'club' && isApprovedClubCore(resource.data.clubId))
        || (resource.data.sourceType == 'school' && isApprovedSchoolRep());
    }

    match /projects/{projectId} {
      allow read: if isRvuEmail();

      allow create: if isRvuEmail()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['open', 'closed'];

      allow update: if isSuperAdmin()
        || (isRvuEmail() && resource.data.ownerId == request.auth.uid && unchanged('ownerId') && unchanged('createdAt'));
        
      allow delete: if isSuperAdmin()
        || (isRvuEmail() && resource.data.ownerId == request.auth.uid);
    }

    match /hostRequests/{requestId} {
      allow create: if isRvuEmail()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['clubCore', 'schoolRepresentative', 'newClub'];

      // Own requests or super admin. School-rep approval is super-admin only.
      allow read: if isSuperAdmin()
        || (isRvuEmail() && resource.data.uid == request.auth.uid);

      allow update: if isSuperAdmin()
        || (isRvuEmail()
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.type == resource.data.type);

      allow delete: if isSuperAdmin();
    }

    match /moderationFlags/{flagId} {
      allow create: if isRvuEmail();
      allow read, update, delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
